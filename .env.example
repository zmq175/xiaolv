# Default: local replay. No credentials are needed for the demo.
XIAOLV_MODE=replay
XIAOLV_CHAT_TTL_SECONDS=45
XIAOLV_QUEUE_MAX_AGE_SECONDS=10
XIAOLV_MODEL_CONCURRENCY=2
XIAOLV_MAX_REPLY_CHARS=200

# Live mode additionally requires every field below, with real values supplied privately.
# XIAOLV_DATABASE_URL=postgresql+psycopg://xiaolv:replace-me@127.0.0.1/xiaolv
# XIAOLV_MODEL_BASE_URL=https://your-provider.example/v1
# XIAOLV_MODEL_API_KEY=replace-me
# XIAOLV_MODEL_ID=explicit-model-id
# XIAOLV_ONEBOT_URL=ws://127.0.0.1:3001
# XIAOLV_ONEBOT_TOKEN=replace-me
# XIAOLV_QQ_SELF_ID=10000
# XIAOLV_MODEL_PROVIDER=explicit-provider-id
# XIAOLV_MODEL_PRICE_VERSION=your-price-version
# Supply actual CNY per million tokens and your independent model budget:
# XIAOLV_MODEL_INPUT_CNY_PER_MILLION=
# XIAOLV_MODEL_OUTPUT_CNY_PER_MILLION=
# XIAOLV_MONTHLY_EXTERNAL_BUDGET_CNY=

# Optional cached-token price (otherwise charge ordinary input price):
# XIAOLV_MODEL_CACHED_INPUT_CNY_PER_MILLION=
# Optional hosting estimate; never caps the model budget:
# XIAOLV_MONTHLY_FIXED_COST_CNY=

# Explicit conversation allowlists; empty by default. Shell-safe JSON arrays.
XIAOLV_ENABLED_GROUP_IDS='[]'
XIAOLV_ENABLED_PRIVATE_IDS='[]'

# Administrator persona; JSON data, not a prompt template. Changes take effect on restart.
# XIAOLV_BOT_PROFILE='{"name":"小绿","aliases":[],"personality":"","participation_style":"有合适的话题再参与。","reply_style":"自然简短。"}'

# Standard Python logging. stderr by default; stdout keeps CLI results.
XIAOLV_LOG_LEVEL=INFO
# Optional per-process file; create its parent directory before startup.
# XIAOLV_LOG_FILE=/path/to/xiaolv.log
XIAOLV_LOG_MAX_BYTES=20971520
XIAOLV_LOG_BACKUP_COUNT=5

# Conversation send guard: cooldown and rolling-window cap, shared through PostgreSQL.
XIAOLV_DELIVERY_POLICY='{"cooldown_seconds":5,"window_seconds":60,"max_messages":6}'

# Separate admin service; not read by the chat process. See docs/admin-service.md.
# XIAOLV_ADMIN_DATABASE_URL=postgresql+psycopg://xiaolv_admin@127.0.0.1/xiaolv
# XIAOLV_ADMIN_PASSWORD_HASH_FILE=/path/outside/repo/admin.hash
# XIAOLV_ADMIN_PORT=8081
# XIAOLV_ADMIN_ORIGIN=http://127.0.0.1:8081

# Opt-in SnowLuma native ASR for enabled conversations; requires fetch_ptt_text support.
# Does not enable TTS or download local/remote audio. See docs/live-voice-service.md.
XIAOLV_NATIVE_ASR_CONVERSATIONS='[]'
